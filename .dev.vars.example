# Local-only configuration template. Copy to .dev.vars; never commit real values.
# SQUARE_ACCESS_TOKEN, SQUARE_WEBHOOK_SIGNATURE_KEY, and
# DOWNLOAD_SIGNING_SECRET are Cloudflare Runtime secrets in production.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
DOWNLOAD_SIGNING_SECRET=
R2_OBJECT_KEY=Ebook lash training manual .pdf
DOWNLOAD_FILENAME=Ebook lash training manual .pdf
SITE_URL=http://localhost:4321

# PUBLIC_* values are compile-time/build variables, not secret Runtime values.
PUBLIC_JOTFORM_TRAINING_URL=https://form.jotform.com/262538566461061
PUBLIC_JOTFORM_WAXING_TRAINING_URL=https://form.jotform.com/262606037948060
PUBLIC_DIGITAL_CHECKOUT_READY=false
