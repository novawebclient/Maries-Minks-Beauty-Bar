{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "maries-minks-beauty-bar",
	"keep_vars": true,
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"vars": {
		"SITE_URL": "https://mariesminksnbeautybar.com",
		"SQUARE_ENVIRONMENT": "sandbox",
		"SQUARE_LOCATION_ID": "LVDEGFQHXTEM8",
		"R2_OBJECT_KEY": "Ebook lash training manual .pdf",
		"DOWNLOAD_FILENAME": "Ebook lash training manual .pdf"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"r2_buckets": [
		{
			"binding": "PDF_BUCKET",
			"bucket_name": "maries-minks-digital-products"
		}
	],
	"secrets_store_secrets": [
		{
			"binding": "SQUARE_ACCESS_TOKEN",
			"store_id": "d32554e8313941efa2272d1c93f801d2",
			"secret_name": "SQUARE_ACCESS_TOKEN"
		},
		{
			"binding": "DOWNLOAD_SIGNING_SECRET",
			"store_id": "d32554e8313941efa2272d1c93f801d2",
			"secret_name": "DOWNLOAD_SIGNING_SECRET"
		},
		{
			"binding": "SQUARE_WEBHOOK_SIGNATURE_KEY",
			"store_id": "d32554e8313941efa2272d1c93f801d2",
			"secret_name": "SQUARE_WEBHOOK_SIGNATURE_KEY"
		}
	]
}
