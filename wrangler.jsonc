{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "maries-minks-beauty-bar",
	"keep_vars": true,
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"vars": {
		"SITE_URL": "https://maries-minks-beauty-bar.angelinadunn1.workers.dev",
		"SQUARE_ENVIRONMENT": "sandbox",
		"SQUARE_LOCATION_ID": "LVDEGFQHXTEM8",
		"R2_OBJECT_KEY": "Ebook lash training manual .pdf",
		"DOWNLOAD_FILENAME": "Ebook lash training manual .pdf"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"r2_buckets": [
		{
			"binding": "PDF_BUCKET",
			"bucket_name": "maries-minks-digital-products"
		}
	]
}
