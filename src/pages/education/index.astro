---
import { Image } from 'astro:assets';
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteSettings } from '../../content/site';
import type { DigitalManualRuntimeEnv } from '../../lib/digital-manual';
import privateTrainingImage from '../../../assets/originals/client-training/private-1-1-lash-training.jpg';
import digitalManualImage from '../../../assets/originals/client-training/digital-lash-training-manual.jpg';

const site = getSiteSettings();
const runtimeEnv = env as unknown as DigitalManualRuntimeEnv;
const jotformUrl = runtimeEnv.JOTFORM_TRAINING_URL?.trim();
const hasJotformUrl = Boolean(jotformUrl?.startsWith('https://'));
---

<BaseLayout
	title={`Lash Education | ${site.displayName}`}
	description={`Choose private 1:1 training or a self-paced digital lash education resource from ${site.displayName}.`}
>
	<header class="education-masthead">
		<div class="container education-masthead-copy">
			<p class="section-kicker">Lash Education</p>
			<h1>Choose Your Learning Experience.</h1>
			<p>Your lash journey, your way.</p>
			<p>Whether you’re ready for personalized hands-on instruction or prefer to learn independently at your own pace, choose the education experience that best fits your goals.</p>
		</div>
	</header>

	<section class="section education-options-section" aria-labelledby="education-options-heading">
		<div class="container">
			<div class="education-options-heading">
				<p class="section-kicker">Two Ways to Learn</p>
				<h2 id="education-options-heading">Start Where You Are.</h2>
			</div>
			<div class="education-option-grid">
				<article class="education-option-card education-option-private">
					<figure class="education-option-image">
						<Image src={privateTrainingImage} alt="Training manual held by the instructor" format="webp" widths={[480, 720, 960]} sizes="(max-width: 46rem) 100vw, 50vw" loading="eager" fetchpriority="high" />
					</figure>
					<div class="education-option-copy">
						<p class="section-kicker">Option 01</p>
						<h2>Private 1:1 Lash Training</h2>
						<p class="education-option-lede">The complete hands-on training experience.</p>
						<p class="education-option-meta">Private · Beginner Friendly · 8 Hours · Live Model · Starter Kit · Certificate · Ongoing Mentorship</p>
						<p class="education-option-price">Investment: $750 <span aria-hidden="true">|</span> $375 Deposit</p>
						<div class="education-option-actions">
							{hasJotformUrl ? (
								<a class="button button-dark" href={jotformUrl} target="_blank" rel="noopener noreferrer">Request Your Training Date <span aria-hidden="true">↗</span></a>
							) : (
								<span class="button button-disabled" aria-disabled="true">Training Request Form Coming Soon</span>
							)}
							<a class="text-link" href="/education/private-1-1/">Explore Private Training <span aria-hidden="true">↓</span></a>
						</div>
					</div>
				</article>

				<article class="education-option-card education-option-digital">
					<figure class="education-option-image">
						<Image src={digitalManualImage} alt="Cover for the digital Lash Training Manual" format="webp" widths={[480, 720, 960]} sizes="(max-width: 46rem) 100vw, 50vw" loading="eager" />
					</figure>
					<div class="education-option-copy">
						<p class="section-kicker">Option 02</p>
						<h2>Digital Lash Training Manual</h2>
						<p class="education-option-lede">Professional lash education at your own pace.</p>
						<p class="education-option-meta">Digital · Self-Paced · Beginner Friendly · 95-Page Educational Resource</p>
						<p class="education-option-price">$147 introductory price</p>
						<div class="education-option-actions">
							<a class="button button-pink" href="/education/digital-manual/">Request the Digital Lash Training Manual <span aria-hidden="true">→</span></a>
							<a class="text-link" href="/education/digital-manual/">Explore the Manual <span aria-hidden="true">↓</span></a>
						</div>
					</div>
				</article>
			</div>
		</div>
	</section>
</BaseLayout>
