---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import hardWax from '../../assets/originals/client-brand/studio-details/150ea0ff-bfc6-4077-8f28-c3b75fb5deca.jpg';
import lashToolDetail from '../../assets/originals/client-brand/studio-details/c5600ddb-5fc9-4cea-b28f-683faf1855a9.jpg';
import { bookingSchedulerUrl, serviceCategories } from '../data/booking';
import { getSiteSettings } from '../content/site';

const site = getSiteSettings();
---

<BaseLayout
	title={`Services | ${site.displayName}`}
	description={`Explore lash, brow, waxing, Brazilian waxing, facial, and beauty services from ${site.displayName}.`}
>
	<section class="section service-editorial-section">
		<div class="container split-feature split-feature-reverse">
			<div class="split-copy">
				<p class="section-kicker">From First Look to Final Detail</p>
				<h1>Choose Your Beauty Moment.</h1>
				<p class="lead-copy">Choose a service below to open the matching booking options.</p>
			</div>
			<figure class="editorial-figure editorial-figure-tall">
				<Image src={hardWax} alt="Hard wax warming on a wooden applicator" format="webp" widths={[480, 720, 960]} sizes="(max-width: 800px) 100vw, 44vw" loading="eager" />
				<figcaption>Waxing Essentials</figcaption>
			</figure>
		</div>
	</section>

	<section class="section service-menu-section" aria-labelledby="service-menu-heading">
		<div class="container service-page-grid">
			<div class="service-image-column">
				<figure class="editorial-figure sticky-figure">
					<Image src={lashToolDetail} alt="Lash spoolie resting over a heart-shaped bowl of cleansing foam" format="webp" widths={[480, 720, 960]} sizes="(max-width: 850px) 100vw, 36vw" loading="lazy" />
					<figcaption>Precision in Every Detail</figcaption>
				</figure>
			</div>
			<div>
				<p class="sr-only" id="service-menu-heading">Service Categories</p>
				<div class="service-stack service-stack-page">
					{serviceCategories.map((service, index) => (
						<details class="service-disclosure" name="service-menu" open={index === 0}>
							<summary>
								<span class="service-number">{service.number}</span>
								<span><small>{service.eyebrow}</small><strong>{service.name}</strong></span>
								<span class="service-count">{service.items.length} options</span>
								<span class="summary-icon" aria-hidden="true"></span>
							</summary>
							<div class="service-disclosure-body service-disclosure-body-stacked">
								<p class="service-intro">{service.intro}</p>
								<ul class="service-booking-links">
									{service.items.map((item) => (
										<li>
											<details class="inline-booking-panel" data-scheduler-panel>
												<summary>{item.name}<span aria-hidden="true">Book ↓</span></summary>
												<div class="inline-scheduler">
													<iframe title={`Schedule ${item.name} with ${site.displayName}`} data-scheduler-src={item.bookingUrl} width="100%" height="760" frameborder="0" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
												</div>
											</details>
										</li>
									))}
								</ul>
								<details class="service-booking-panel" data-scheduler-panel>
									<summary class="text-link">View All {service.name} Booking Options <span aria-hidden="true">↓</span></summary>
									<div class="inline-scheduler">
										<iframe title={`Schedule ${service.name} with ${site.displayName}`} data-scheduler-src={service.bookingUrl} width="100%" height="760" frameborder="0" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
									</div>
								</details>
							</div>
						</details>
					))}
				</div>
				<details class="service-booking-panel service-menu-cta" data-scheduler-panel>
					<summary class="button button-dark">View All Services <span aria-hidden="true">↓</span></summary>
					<div class="inline-scheduler">
						<iframe title={`Schedule a service with ${site.displayName}`} data-scheduler-src={bookingSchedulerUrl} width="100%" height="760" frameborder="0" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
					</div>
				</details>
			</div>
		</div>
	</section>

	<script is:inline>
		(() => {
			const panels = document.querySelectorAll('[data-scheduler-panel]');

			panels.forEach((panel) => {
				if (!(panel instanceof HTMLDetailsElement)) return;

				panel.addEventListener('toggle', () => {
					if (!panel.open) return;

					const frame = panel.querySelector('[data-scheduler-src]');
					if (!(frame instanceof HTMLIFrameElement) || !frame.dataset.schedulerSrc || frame.getAttribute('src')) return;

					frame.src = frame.dataset.schedulerSrc;
				});
			});
		})();
	</script>
	<script is:inline async src="https://embed.acuityscheduling.com/js/embed.js" type="text/javascript"></script>
</BaseLayout>
