---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portraitHero from '../../assets/originals/client-questionnaire/DB8_1325-Edit.jpeg';
import portraitAbout from '../../assets/originals/client-questionnaire/DB8_1368-Edit.jpeg';
import { generalBookingPath } from '../data/booking';
import { getSiteSettings } from '../content/site';
import { withBase } from '../utils/urls';

const site = getSiteSettings();
---

<BaseLayout
	title={`About | ${site.displayName}`}
	description={`Learn about the beauty-bar experience at ${site.displayName} in ${site.serviceArea}.`}
>
	<header class="page-masthead page-masthead-dark">
		<Image src={portraitHero} alt="Studio portrait of a person standing in black against a bright background" class="masthead-background" format="webp" loading="eager" fetchpriority="high" />
		<div class="masthead-overlay" aria-hidden="true"></div>
		<div class="container masthead-content">
			<p class="section-kicker section-kicker-pink">About the beauty bar</p>
			<h1>Beauty care, finished with intention.</h1>
			<p>One polished destination for lashes, waxing, facials, and the appointments that support your routine.</p>
		</div>
	</header>

	<section class="section intro-section">
		<div class="container split-feature">
			<figure class="editorial-figure editorial-figure-tall">
				<Image src={portraitAbout} alt="Studio portrait of a person seated in black against a bright background" format="webp" widths={[480, 720, 960]} sizes="(max-width: 800px) 100vw, 44vw" loading="eager" />
				<figcaption>Marie’s Minks &amp; Beauty Bar</figcaption>
			</figure>
			<div class="split-copy">
				<p class="section-kicker">The studio story</p>
				<h2>A full beauty bar, built around your next appointment.</h2>
				<p class="lead-copy">{site.displayName} brings several beauty-service categories together in one clear experience, from learning what is available to reserving online.</p>
				<p>The final technician biography, credentials, specialties, and confirmed portrait usage will complete this story before launch. Until then, the site keeps its focus on the beauty-bar experience rather than unverified personal claims.</p>
				<a class="text-link" href={withBase('/services/')}>Explore services <span aria-hidden="true">↓</span></a>
			</div>
		</div>
	</section>

	<section class="section values-section" aria-labelledby="values-heading">
		<div class="container">
			<div class="section-heading-wide">
				<div><p class="section-kicker">The intended experience</p><h2 id="values-heading">Polished at every step.</h2></div>
				<p>These are design and messaging themes for client review, not unverified claims about licenses, results, or policies.</p>
			</div>
			<div class="value-grid">
				<article><span>01</span><h3>Easy discovery</h3><p>Clear service categories help visitors understand what belongs together before they book.</p></article>
				<article><span>02</span><h3>Direct scheduling</h3><p>The live booking calendar keeps current options, times, and appointment details in one place.</p></article>
				<article><span>03</span><h3>Intentional presentation</h3><p>Editorial type, focused color, and original imagery create a memorable beauty-bar identity.</p></article>
			</div>
		</div>
	</section>

	<section class="section client-details-section" aria-labelledby="details-heading">
		<div class="container details-grid">
			<div><p class="section-kicker">Before launch</p><h2 id="details-heading">The story still needs Marie’s voice.</h2></div>
			<div class="client-details-list">
				<p><span>01</span> Preferred name, professional title, and pronouns</p>
				<p><span>02</span> Approved biography, experience, licenses, and certifications</p>
				<p><span>03</span> Specialties, service philosophy, and what clients should expect</p>
				<p><span>04</span> Approved portrait, studio images, and portfolio permissions</p>
			</div>
		</div>
	</section>

	<section class="section final-cta-section">
		<div class="container final-cta">
			<p class="section-kicker">Ready when you are</p>
			<h2>Make time for your beauty routine.</h2>
			<a class="button button-dark" href={generalBookingPath}>Book with Marie’s <span aria-hidden="true">↓</span></a>
		</div>
	</section>
</BaseLayout>
