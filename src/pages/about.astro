---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portraitHero from '../../assets/originals/client-questionnaire/DB8_1325-Edit.jpeg';
import portraitAbout from '../../assets/originals/client-questionnaire/DB8_1368-Edit.jpeg';
import lashToolDetail from '../../assets/originals/client-brand/studio-details/c5600ddb-5fc9-4cea-b28f-683faf1855a9.jpg';
import { getSiteSettings } from '../content/site';
import { withBase } from '../utils/urls';

const site = getSiteSettings();
---

<BaseLayout
	title={`About | ${site.displayName}`}
	description={`Learn about the beauty-bar experience at ${site.displayName} in ${site.serviceArea}.`}
>
	<header class="page-masthead page-masthead-dark about-masthead">
		<Image src={portraitHero} alt="Studio portrait of a person standing in black against a bright background" class="masthead-background" format="webp" loading="eager" fetchpriority="high" />
		<div class="masthead-overlay" aria-hidden="true"></div>
		<div class="container masthead-content">
			<p class="section-kicker section-kicker-pink">About Marie’s Minks n Beauty Bar</p>
			<h1>Meet Angelina Marie.</h1>
		</div>
	</header>

	<section class="section intro-section">
		<div class="container split-feature">
			<figure class="editorial-figure editorial-figure-tall">
				<Image src={portraitAbout} alt="Studio portrait of a person seated in black against a bright background" format="webp" widths={[480, 720, 960]} sizes="(max-width: 800px) 100vw, 44vw" loading="eager" />
				<figcaption>Marie’s Minks n Beauty Bar</figcaption>
			</figure>
			<article class="split-copy about-story">
				<h2>Hi, Beauties! 💕</h2>
				<p class="lead-copy">I’m Angelina Marie, a Licensed Esthetician and the woman behind Marie’s Minks n Beauty Bar. What began as a personal love for beauty and self-care has grown into a career that allows me to help others feel confident, cared for, and beautiful in their own skin.</p>
				<p>My love for the beauty industry started in my teenage years. At first, beauty was simply something I enjoyed as a way to pamper myself, but over time it became so much more. I realized that self-care could be a form of self-love, a way to slow down, reset, and reconnect with yourself. That feeling of confidence and comfort is something I wanted to give to other women, and it ultimately led me to become a Licensed Esthetician and build a business of my own.</p>
				<p>Over the years, I’ve continued expanding my education and mastering different areas of the beauty industry. I specialize in wet and wispy lash extensions while also offering brow laminations, Brazilian waxing, and customized facials. I love being versatile in my craft and creating services tailored to each individual client rather than taking a one-size-fits-all approach to beauty.</p>
				<p>As my career has grown, so has my passion for education. I’ve expanded beyond providing services and into teaching and mentoring other beauty professionals. Being able to share the knowledge and experience I’ve gained along the way has opened an entirely new chapter for me. My goal is to continue growing as both an esthetician and educator while creating resources, mentorship opportunities, and education for those building careers of their own in the beauty industry.</p>
				<p>For me, Marie’s Minks n Beauty Bar has never been just about the service itself. I want every client who sits in my chair to feel like they are entering a safe, welcoming space where they can relax, be themselves, and leave feeling refreshed and confident. Life can be busy and challenging, and sometimes having that little piece of time dedicated completely to yourself makes all the difference.</p>
				<p>Outside of the treatment room, I’m someone who loves new experiences, the beach, music, and staying active. The beach has always been one of my favorite places to relax and reset, while music is another escape for me. I can easily get lost in a song and sing for hours. You’ll also often find me in the gym, which has become one of my favorite ways to relieve stress, clear my mind, and practice another form of self-care.</p>
				<p>I’m incredibly grateful for every client who has trusted me, supported my business, referred a friend, taken a class with me, or simply followed along with my journey. What started as a passion has grown into something I’m incredibly proud of, and I know there is still so much more ahead.</p>
				<p>My mission is simple: to enhance the beauty that is already there, uplift the women who enter my space, and use everything I’ve learned to help the next generation of beauty professionals grow with confidence.</p>
				<figure class="about-brand-detail">
					<Image src={lashToolDetail} alt="Lash spoolie resting over a heart-shaped bowl of cleansing foam" format="webp" widths={[480, 720, 960]} sizes="(max-width: 800px) 100vw, 35rem" loading="lazy" />
					<figcaption>Precision in Every Detail</figcaption>
				</figure>
				<a class="text-link" href={withBase('/services/')}>Explore Services <span aria-hidden="true">↓</span></a>
			</article>
		</div>
	</section>
</BaseLayout>
