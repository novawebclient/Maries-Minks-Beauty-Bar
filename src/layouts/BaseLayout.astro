---
import { Image } from 'astro:assets';
import '../styles/global.css';
import { getSiteSettings } from '../content/site';
import { withBase } from '../utils/urls';
import headerPortrait from '../../assets/originals/client-questionnaire/brand-header-portrait.png';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
const socialImage = Astro.site ? new URL('/og.png', Astro.site).toString() : undefined;
const site = getSiteSettings();

const navigation = [
	{ href: '/', label: 'Home' },
	{ href: '/about/', label: 'About' },
	{ href: '/services/', label: 'Services' },
	{ href: '/gallery/', label: 'Gallery' },
	{ href: '/training/', label: 'Training' },
	{ href: '/contact/', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#ec4f91" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{socialImage && <meta property="og:image" content={socialImage} />}
		<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{socialImage && <meta name="twitter:image" content={socialImage} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to Main Content</a>
		<header class="site-header">
			<div class="container header-inner">
				<a class="wordmark" href={withBase('/')} aria-label={`${site.displayName} home`}>
					<Image src={headerPortrait} alt="" class="wordmark-portrait" widths={[64, 96, 128]} sizes="44px" loading="eager" />
					<span>{site.displayName}</span>
				</a>
				<nav aria-label="Main navigation">
					<ul class="nav-list">
						{navigation.map((item) => (
							<li>
								<a href={withBase(item.href)} aria-current={currentPath === withBase(item.href) ? 'page' : undefined}>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
				<details class="mobile-nav">
					<summary>Menu</summary>
					<nav aria-label="Mobile navigation">
						<ul>
							{navigation.map((item) => (
								<li><a href={withBase(item.href)}>{item.label}</a></li>
							))}
						</ul>
					</nav>
				</details>
				<a class="header-book" href={withBase('/services/')}>Book Now <span aria-hidden="true">↓</span></a>
			</div>
		</header>
		<main id="main-content">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="container footer-main">
				<div class="footer-brand">
					<p class="footer-mark" aria-hidden="true">MM</p>
					<p class="footer-name">{site.displayName}</p>
					<p class="footer-note">Lashes · Waxing · Brows · Facials</p>
					<p class="footer-contact"><a href={site.contact.phoneHref}>{site.contact.phoneDisplay}</a><br /><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
				</div>
				<nav aria-label="Footer navigation">
					<ul class="footer-nav">
						{navigation.slice(1).map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
						<li><a href={withBase('/privacy/')}>Privacy</a></li>
						<li><a href={withBase('/policies/')}>Policies</a></li>
					</ul>
				</nav>
			</div>
			<div class="container footer-legal">
				<p>© 2026 {site.displayName}</p>
				<p>{site.hours} · {site.serviceArea}</p>
			</div>
		</footer>
	</body>
</html>
